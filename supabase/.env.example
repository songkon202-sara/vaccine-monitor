# คัดลอกเป็น supabase/.env แล้วกรอกค่า จากนั้นรัน:
#   supabase secrets set --env-file supabase/.env --project-ref <PROJECT_REF>
# ห้ามนำไฟล์ .env ขึ้น GitHub (อยู่ใน .gitignore แล้ว)

# จาก LINE Developers Console -> Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ข้อความสุ่มยาว ๆ (ต้องตรงกับค่าใน supabase/cron.sql)
CRON_SECRET=

# รหัสสำหรับพิมพ์ "ตั้งกลุ่มนี้ <รหัส>" ในกลุ่ม LINE
SETUP_PASSCODE=

# (ไม่บังคับ) LINE userId ของผู้รับผิดชอบหลัก คั่นด้วยจุลภาค ใช้แจ้งซ้ำเมื่อไม่มีใครรับทราบ
# ให้แต่ละคนพิมพ์ /myid ในแชตกับบอทเพื่อดู userId
ESCALATION_USER_IDS=

# (ไม่บังคับ) นาทีที่รอก่อนแจ้งซ้ำ และช่วงกันส่งซ้ำชนิดเดียวกัน
ESCALATE_AFTER_MIN=20
ALERT_COOLDOWN_MIN=30

# (ไม่บังคับ) เตือนซ้ำจนกว่าจะกลับปกติ: ไม่มีผู้รับทราบ เตือนทุกกี่นาที / รับทราบแล้วแต่ยังไม่กลับปกติ ติดตามผลทุกกี่นาที / ไม่เกินกี่ครั้งต่อเรื่อง
REMIND_UNACKED_MIN=30
REMIND_ACKED_MIN=120
REMIND_MAX=8

# (ไม่บังคับ) โพรบ 2 ตัวในช่องเดียวกัน (devices.twin_of) อ่านค่าเฉลี่ยต่างกันเกินกี่ °C ให้แจ้ง
PROBE_DIFF_LIMIT=2

# (แนะนำ) ช่องทางสำรอง Telegram ฟรี ไม่มีโควตา: สร้างบอทจาก @BotFather แล้วเพิ่มบอทเข้ากลุ่มที่ต้องการให้รับแจ้งเตือน
# TELEGRAM_CHAT_ID คือเลขกลุ่ม (ขึ้นต้นด้วย - สำหรับกลุ่ม) ห้ามนำ token ไปใส่ในแชตหรือ GitHub
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (แนะนำ) URL สำหรับเฝ้าระบบจาก healthchecks.io (ฟรี) ถ้าระบบตรวจหยุดทำงานหรือส่ง LINE ไม่ได้ จะได้อีเมลเตือน
HEARTBEAT_URL=
# (ถ้ากลุ่มมีหัวข้อ Topics) เลขหัวข้อที่จะให้ส่งเข้า
TELEGRAM_THREAD_ID=
