# คัดลอกเป็น supabase/.env แล้วกรอกค่า จากนั้นรัน:
#   supabase secrets set --env-file supabase/.env --project-ref <PROJECT_REF>
# ห้ามนำไฟล์ .env ขึ้น GitHub (อยู่ใน .gitignore แล้ว)

# จาก LINE Developers Console -> Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ข้อความสุ่มยาว ๆ (ต้องตรงกับค่าใน supabase/cron.sql)
CRON_SECRET=

# รหัสสำหรับพิมพ์ "ตั้งกลุ่มนี้ <รหัส>" ในกลุ่ม LINE
SETUP_PASSCODE=

# (ไม่บังคับ) LINE userId ของผู้รับผิดชอบหลัก คั่นด้วยจุลภาค ใช้แจ้งซ้ำเมื่อไม่มีใครรับทราบ
# ให้แต่ละคนพิมพ์ /myid ในแชตกับบอทเพื่อดู userId
ESCALATION_USER_IDS=

# (ไม่บังคับ) นาทีที่รอก่อนแจ้งซ้ำ และช่วงกันส่งซ้ำชนิดเดียวกัน
ESCALATE_AFTER_MIN=20
ALERT_COOLDOWN_MIN=30
